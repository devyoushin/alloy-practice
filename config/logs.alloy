// ============================================================
// 로그 수집 전용 Alloy 설정
// 대상: Kubernetes Pod 로그 (DaemonSet으로 배포)
// 목적지: Grafana Loki
// ============================================================

// ────────────────────────────────────────
// 1. Pod 발견
// ────────────────────────────────────────

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  // Running 상태 Pod만
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Running"
    action        = "keep"
  }

  // 레이블 추가
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "app_kubernetes_io_name"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }
}

// ────────────────────────────────────────
// 2. 로그 수집 (Kubernetes API 방식)
// ────────────────────────────────────────

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.parse.receiver]
}

// ────────────────────────────────────────
// 3. 로그 처리 (파싱 + 필터링)
// ────────────────────────────────────────

loki.process "parse" {
  forward_to = [loki.write.loki.receiver]

  // JSON 로그 파싱 (앱이 JSON으로 출력하는 경우)
  stage.json {
    expressions = {
      level    = "level",
      msg      = "msg",
      trace_id = "traceID",
    }
  }

  // level 필드를 레이블로 추가
  stage.labels {
    values = {
      level = "",
    }
  }

  // 헬스체크 로그 제거 (불필요한 노이즈)
  stage.drop {
    expression          = ".*GET /health.*"
    drop_counter_reason = "healthcheck"
  }

  stage.drop {
    expression          = ".*GET /ready.*"
    drop_counter_reason = "readiness_check"
  }

  stage.drop {
    expression          = ".*GET /metrics.*"
    drop_counter_reason = "metrics_scrape"
  }
}

// ────────────────────────────────────────
// 4. Loki로 전송
// ────────────────────────────────────────

loki.write "loki" {
  endpoint {
    url = "http://loki-gateway.monitoring.svc.cluster.local/loki/api/v1/push"

    headers = {
      "X-Scope-OrgID" = "default",
    }

    backoff_config {
      min_period  = "500ms"
      max_period  = "5m"
      max_retries = 10
    }
  }

  external_labels = {
    cluster = "eks-production",
    region  = "ap-northeast-2",
  }
}
